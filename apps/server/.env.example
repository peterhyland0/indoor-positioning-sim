PORT=8080
# Supabase session-pooler URI (see db/README.md). Leave unset to run without persistence.
DATABASE_URL=
# Which estimator's answer is sent back to Unreal and drives the dashboard by default.
PRIMARY_ESTIMATOR=fused
HOURLY_RATE=45
# Where recorded sessions live, for /api/recordings and POST /api/replay
SESSIONS_DIR=../../sessions
